---
import "../styles/global.css";
import NavbarAstroComponent from "../components/Navbar.astro";
import AboutAstroComponent from "../components/About.astro";
import ProjectsAstroComponent from "../components/Projects.astro";
import ContactAstroComponent from "../components/Contact.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Brandon Luna</title>
  </head>

  <body class="min-h-screen bg-[oklch(0.21_0.006_285.885)] text-white">
    <main class="w-full max-w-2xl mx-auto px-4 sm:px-6 lg:px-0">
      <NavbarAstroComponent />
      <AboutAstroComponent />
      <ProjectsAstroComponent />
      <ContactAstroComponent />
    </main>
  </body>
</html>